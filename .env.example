# ==============================================================================
# ENGNEST BACKEND API - CẤU HÌNH PHÁT TRIỂN LOCAL (.env)
# ==============================================================================
# Hướng dẫn nhanh: Copy file này thành .env (cp .env.example .env)
# Mặc định hệ thống chạy 100% môi trường LOCAL ISOLATED (Cách ly hoàn toàn Production)
# ==============================================================================

# 1. Ứng dụng & Cổng dịch vụ
PORT=4000
NODE_ENV=development
APP_NAME=EngNest API
PUBLIC_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# 2. Cơ sở dữ liệu PostgreSQL (Mặc định Localhost)
# Lưu ý: DB_SSL=false là bắt buộc đối với Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=brightlingo_db
DB_SSL=false

# LƯU Ý BẢO VỆ DỮ LIỆU CLOUD:
# - KHÔNG cấu hình DATABASE_URL trỏ tới Neon/Cloud trên máy cá nhân để tránh làm sai lệch dữ liệu thật.
# - Sau khi cấu hình DB local, chạy lệnh: npm run db:setup để tự động khởi tạo 16 bảng và dữ liệu mẫu.
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/brightlingo_db

# 3. Lưu trữ tệp tin (Storage)
# R2_ENABLED=false: Mặc định lưu ảnh & video tải lên vào thư mục cục bộ ./uploads
# Giúp test tải ảnh/video trơn tru mà không cần tài khoản Cloudflare R2
R2_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=engnest-media
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# 4. Cổng thanh toán PayOS & Webhook
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Khi test Webhook thanh toán ở Local, khởi động ngrok (ngrok http 4000) và điền URL vào bên dưới:
# PAYOS_WEBHOOK_URL=https://your-subdomain.ngrok-free.dev/api/webhooks/payos

# 5. Thông tin thụ hưởng VietQR (Fallback dự phòng)
PAYMENT_BANK_NAME=MBBANK
PAYMENT_ACCOUNT_NUMBER=0399046519
PAYMENT_ACCOUNT_NAME=HA VAN MANH
PAYMENT_ORDER_PREFIX=BL

# 6. Dịch vụ Email (Resend)
# Ở môi trường local dev: Để trống RESEND_API_KEY, hệ thống sẽ tự động bật Mock Mode (log ra console, không lỗi)
RESEND_API_KEY=
MAIL_FROM=hotro@engnest.vn
SUPPORT_EMAIL=hotro@engnest.vn
SUPPORT_PHONE=1900 8989
